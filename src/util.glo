//! fls/src/util.glo - small text, path, identity and time helpers shared by
//! the CLI listing and the TUI browser.

#import "Io";
#import "Context";
#import "Format";
#import "Strings";
#import "String_Builder";
#import "Terminal";
#import "Time";
#import "Math/Core";
#import "Unicode";

#public {

/// Frees an owned string and leaves the zero (null) string in its place,
/// which is safe to free again. Never store a literal in an owned field:
/// a literal's bytes are static and must not be freed.
free_string :: (s: *str) {
    s.free();
    empty: str;
    s.* = empty;
}

/// Replaces an owned string with a copy of `value`.
set_string :: (s: *str, value: str) {
    copy := value.clone();
    s.free();
    s.* = copy;
}

/// Display width of `text` in terminal cells.
text_width :: (text: str) -> ssize {
    return terminal_text_width(text);
}

/// Writes `text` and pads it with spaces to `width` display cells.
write_padded :: (out: *String_Builder, text: str, width: ssize) {
    out.write_string(text);
    pad := width - text_width(text);
    if pad > 0 out.write_repeated_byte(#char " ", pad);
}

/// Writes `text` right-aligned in a column `width` display cells wide.
write_right :: (out: *String_Builder, text: str, width: ssize) {
    pad := width - text_width(text);
    if pad > 0 out.write_repeated_byte(#char " ", pad);
    out.write_string(text);
}

/// Truncates `text` to at most `width` cells, ending with `~` when cut.
/// The result is a view into `text` or a temporary string.
fit_width :: (text: str, width: ssize) -> str {
    if width <= 0 return "";
    if text_width(text) <= width return text;
    used: ssize = 0;
    i: ssize = 0;
    while i < text.count {
        value, count := decode_utf8(text, i);
        w := terminal_rune_width(value);
        if used + w > width - 1 break;
        used += w;
        i += count;
    }
    return tprint("{}~", text[0..i]);
}

/// Decodes the UTF-8 scalar at byte `i`; invalid bytes decode as U+FFFD
/// and consume one byte.
decode_utf8 :: (text: str, i: ssize) -> (u32, ssize) {
    c := cast(u32) text[i];
    if c < 16#80 return c, 1;
    need: ssize = 0;
    value: u32 = 0;
    if c >= 16#c2 && c < 16#e0 {
        need = 1;
        value = c & 16#1f;
    } else if c >= 16#e0 && c < 16#f0 {
        need = 2;
        value = c & 16#0f;
    } else if c >= 16#f0 && c < 16#f5 {
        need = 3;
        value = c & 16#07;
    } else return 16#fffd, 1;
    if i + need >= text.count return 16#fffd, 1;
    for k: 1..need + 1 {
        b := cast(u32) text[i + k];
        if (b & 16#c0) != 16#80 return 16#fffd, 1;
        value = (value << 6) | (b & 16#3f);
    }
    return value, need + 1;
}

lower_byte :: (c: u8) -> u8 {
    if c >= #char "A" && c <= #char "Z" return c + 32;
    return c;
}

is_digit :: (c: u8) -> bool {
    return c >= #char "0" && c <= #char "9";
}

/// Natural ordering exactly as the `natord` crate (and so eza) does it:
/// whitespace is skipped, digit runs compare by value ("file2" < "file10"),
/// and runs with a leading zero compare as fractions. `fold_case`
/// compares letters by their lowercase mapping.
natural_compare :: (a: str, b: str, fold_case: bool) -> Ordering {
    i: ssize = 0;
    j: ssize = 0;
    while true {
        i = skip_whitespace(a, i);
        j = skip_whitespace(b, j);
        if i >= a.count && j >= b.count return .Equal;
        if i >= a.count return .Less;
        if j >= b.count return .Greater;
        ca := a[i];
        cb := b[j];
        if is_digit(ca) && is_digit(cb) {
            fractional := ca == #char "0" || cb == #char "0";
            order, ni, nj := compare_digit_runs(a, i, b, j, fractional);
            if order != .Equal return order;
            i = ni;
            j = nj;
            continue;
        }
        ra, na := decode_utf8(a, i);
        rb, nb := decode_utf8(b, j);
        if fold_case {
            ra = Unicode_Field.Simple_Lowercase_Mapping.get_rune(ra);
            rb = Unicode_Field.Simple_Lowercase_Mapping.get_rune(rb);
        }
        if ra != rb return ra <=> rb;
        i += na;
        j += nb;
    }
    return .Equal;
}

/// Case-insensitive ASCII substring test.
contains_fold :: (haystack: str, needle: str) -> bool {
    if needle.count == 0 return true;
    if needle.count > haystack.count return false;
    for i: 0..haystack.count - needle.count + 1 {
        matched := true;
        for k: 0..needle.count {
            if lower_byte(haystack[i + k]) != lower_byte(needle[k]) {
                matched = false;
                break;
            }
        }
        if matched return true;
    }
    return false;
}

/// Shell-style glob match supporting `*`, `?` and `[...]` classes.
glob_match :: (pattern: str, text: str) -> bool {
    p: ssize = 0;
    t: ssize = 0;
    star_p: ssize = -1;
    star_t: ssize = 0;
    while t < text.count {
        if p < pattern.count {
            c := pattern[p];
            if c == #char "*" {
                star_p = p;
                star_t = t;
                p += 1;
                continue;
            }
            if c == #char "?" {
                p += 1;
                t += 1;
                continue;
            }
            if c == #char "[" {
                matched, next := glob_class(pattern, p, text[t]);
                if next > 0 && matched {
                    p = next;
                    t += 1;
                    continue;
                }
                if next < 0 && text[t] == c {
                    p += 1;
                    t += 1;
                    continue;
                }
            } else if c == text[t] {
                p += 1;
                t += 1;
                continue;
            }
        }
        if star_p < 0 return false;
        p = star_p + 1;
        star_t += 1;
        t = star_t;
    }
    while p < pattern.count && pattern[p] == #char "*" p += 1;
    return p == pattern.count;
}

/// Final path component of `path`, ignoring trailing slashes.
base_name :: (path: str) -> str {
    end := path.count;
    while end > 1 && path[end - 1] == #char "/" end -= 1;
    i := end;
    while i > 0 && path[i - 1] != #char "/" i -= 1;
    if i == end return path[0..end];
    return path[i..end];
}

/// Parent directory of `path` ("/" for the root, "." for a bare name).
parent_path :: (path: str) -> str {
    end := path.count;
    while end > 1 && path[end - 1] == #char "/" end -= 1;
    i := end;
    while i > 0 && path[i - 1] != #char "/" i -= 1;
    if i == 0 return ".";
    while i > 1 && path[i - 1] == #char "/" i -= 1;
    return path[0..i];
}

/// `dir/name` as a newly allocated string. The caller frees it.
join_path :: (dir: str, name: str) -> str {
    if dir.count == 0 return name.clone();
    if dir[dir.count - 1] == #char "/" return format("{}{}", dir, name);
    return format("{}/{}", dir, name);
}

/// Lowercased extension of `name` without the dot, as a temporary string;
/// empty when there is none. As in eza, a dotfile's name after the dot
/// counts as its extension.
extension_of :: (name: str) -> str {
    i := name.count;
    while i > 0 {
        i -= 1;
        if name[i] == #char "." {
            ext := name[i + 1..name.count];
            if ext.count == 0 return "";
            b: String_Builder;
            b.allocator = context.temp_allocator;
            for k: 0..ext.count b.write_byte(lower_byte(ext[k]));
            return b.to_string();
        }
    }
    return "";
}

}

skip_whitespace :: (text: str, start: ssize) -> ssize {
    i := start;
    while i < text.count {
        c := text[i];
        if c == #char " " || (c >= 9 && c <= 13) {
            i += 1;
            continue;
        }
        if c < 128 break;
        value, count := decode_utf8(text, i);
        if !Unicode_Field.Is_Whitespace.get_bool(value) break;
        i += count;
    }
    return i;
}

/// natord's digit-run comparison. Without a leading zero the longer run wins
/// and otherwise the first differing digit decides (remembered as a bias);
/// with one, the first differing digit wins at once. Returns the order and
/// the positions after the runs.
compare_digit_runs :: (a: str, i0: ssize, b: str, j0: ssize, fractional: bool) -> (
    Ordering,
    ssize,
    ssize
) {
    i := i0;
    j := j0;
    bias := Ordering.Equal;
    while true {
        da := i < a.count && is_digit(a[i]);
        db := j < b.count && is_digit(b[j]);
        if da && db {
            if a[i] != b[j] {
                if fractional return a[i] <=> b[j], i, j;
                if bias == .Equal bias = a[i] <=> b[j];
            }
            i += 1;
            j += 1;
            continue;
        }
        if da return .Greater, i, j;
        if db return .Less, i, j;
        return bias, i, j;
    }
    return bias, i, j;
}

/// Matches one `[...]` class at `pattern[start]` against `c`. Returns whether
/// it matched and the index after the class, or -1 when the class is unclosed.
glob_class :: (pattern: str, start: ssize, c: u8) -> (bool, ssize) {
    i := start + 1;
    negate := false;
    if i < pattern.count && (pattern[i] == #char "!" || pattern[i] == #char "^") {
        negate = true;
        i += 1;
    }
    matched := false;
    first := true;
    while i < pattern.count {
        ch := pattern[i];
        if ch == #char "]" && !first return matched != negate, i + 1;
        first = false;
        if i + 2 < pattern.count && pattern[i + 1] == #char "-" && pattern[i + 2] != #char "]" {
            if c >= ch && c <= pattern[i + 2] matched = true;
            i += 3;
            continue;
        }
        if c == ch matched = true;
        i += 1;
    }
    return false, -1;
}

// ---------------------------------------------------------------------------
// User and group names.

Passwd :: struct #c_call {
    name: ?[*]const u8;
}

Group_Entry :: struct #c_call {
    name: ?[*]const u8;
}

libc :: #library "c";
c_getpwuid :: (uid: u32) -> ?*Passwd #foreign libc "getpwuid";
c_getgrgid :: (gid: u32) -> ?*Group_Entry #foreign libc "getgrgid";
c_getuid :: () -> u32 #foreign libc "getuid";
c_getgid :: () -> u32 #foreign libc "getgid";
c_getgroups :: (size: s32, list: *u32) -> s32 #foreign libc "getgroups";
c_gethostname :: (name: *u8, len: usize) -> s32 #foreign libc "gethostname";
c_strerror :: (code: s32) -> ?[*]const u8 #foreign libc "strerror";

raw_string :: (data: [*]const u8, count: ssize) -> str #magic "string_from_raw_parts";

c_name :: (data: ?[*]const u8) -> ?str {
    #pattern ?bytes := data else {
        return null;
    };
    count: ssize = 0;
    while bytes[count] != 0 count += 1;
    return raw_string(bytes, count).clone();
}

Id_Name :: struct {
    id: u64;
    name: str;
}

user_cache: [..]Id_Name;
group_cache: [..]Id_Name;
own_groups: [..]u64;
own_groups_loaded := false;

#public {

/// The user name for `uid`, or its number when the system has none.
/// The result lives as long as the program.
user_name :: (uid: u64) -> str {
    for entry: user_cache if entry.id == uid return entry.name;
    #push_allocator(heap_allocator());
    name: str;
    #pattern ?found := c_getpwuid(cast(u32) uid) else {
        name = format("{}", uid);
        user_cache.push(.{ uid, name });
        return name;
    };
    name = c_name(found.name).unwrap_or(format("{}", uid));
    user_cache.push(.{ uid, name });
    return name;
}

/// The group name for `gid`, or its number when the system has none.
group_name :: (gid: u64) -> str {
    for entry: group_cache if entry.id == gid return entry.name;
    #push_allocator(heap_allocator());
    name: str;
    #pattern ?found := c_getgrgid(cast(u32) gid) else {
        name = format("{}", gid);
        group_cache.push(.{ gid, name });
        return name;
    };
    name = c_name(found.name).unwrap_or(format("{}", gid));
    group_cache.push(.{ gid, name });
    return name;
}

/// The C library's message for an errno value, e.g. "Permission denied".
os_error_text :: (code: s64) -> str {
    #pattern ?bytes := c_strerror(cast(s32) code) else {
        return "Unknown error";
    };
    count: ssize = 0;
    while bytes[count] != 0 count += 1;
    return raw_string(bytes, count);
}

current_uid :: () -> u64 {
    return cast(u64) c_getuid();
}

/// Whether the current process is a member of group `gid`.
in_group :: (gid: u64) -> bool {
    if !own_groups_loaded {
        #push_allocator(heap_allocator());
        own_groups_loaded = true;
        own_groups.push(cast(u64) c_getgid());
        buffer: [256]u32;
        n := c_getgroups(256, &buffer[0]);
        for i: 0..cast(ssize) n own_groups.push(cast(u64) buffer[i]);
    }
    for g: own_groups if g == gid return true;
    return false;
}

host_name :: () -> str {
    buffer: [256]u8;
    if c_gethostname(&buffer[0], 255) != 0 return "";
    count: ssize = 0;
    while count < 255 && buffer[count] != 0 count += 1;
    return raw_string(buffer.data, count).clone();
}

}

// ---------------------------------------------------------------------------
// Time formatting.

local_zone: Timezone;
local_zone_state := 0; // 0 unknown, 1 loaded, 2 unavailable
now_seconds: s64 = 0;

MONTHS: [12]str = .[
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec"
];

#public {

Time_Style :: enum {
    Default;
    Iso;
    Long_Iso;
    Full_Iso;
    Relative;
}

current_time :: () -> s64 {
    if now_seconds == 0 {
        now_seconds = unix_now().unwrap_or(.{}).seconds;
    }
    return now_seconds;
}

refresh_time :: () {
    now_seconds = unix_now().unwrap_or(.{}).seconds;
}

/// Local civil time of a Unix timestamp, plus its UTC offset in seconds.
local_date :: (seconds: s64, nanos: u32 = 0) -> (Date_Time, s64) {
    if local_zone_state == 0 {
        #push_allocator(heap_allocator());
        local_zone_state = 2;
        if timezone_load_local() == {
            case .Ok(zone);
                local_zone = zone;
                local_zone_state = 1;
            else;
        }
    }
    stamp := Unix_Timestamp.{ seconds, nanos };
    if local_zone_state == 1 {
        if local_zone.to_local(stamp) == {
            case .Ok(zoned);
                return zoned.value, cast(s64) zoned.offset.seconds;
            else;
        }
    }
    return stamp.to_date_time().unwrap_or(.{}), 0;
}

/// Formats a timestamp in one of eza's time styles, as a temporary string.
format_time :: (seconds: s64, nanos: u32, style: Time_Style) -> str {
    dt, offset := local_date(seconds, nanos);
    d := dt.date;
    t := dt.time;
    if style == {
        case .Default;
            now_dt, _ := local_date(current_time());
            month := MONTHS[(cast(ssize) d.month - 1).clamp(0, 11)];
            if d.year == now_dt.date.year {
                return tprint("{} {} {}:{}", pad2s(d.day), month, pad2(t.hour), pad2(t.minute));
            }
            return tprint("{} {}  {}", pad2s(d.day), month, d.year);
        case .Iso;
            now_dt, _ := local_date(current_time());
            if d.year == now_dt.date.year {
                return tprint(
                    "{}-{} {}:{}",
                    pad2(d.month),
                    pad2(d.day),
                    pad2(t.hour),
                    pad2(t.minute)
                );
            }
            return tprint("{}-{}-{}", d.year, pad2(d.month), pad2(d.day));
        case .Long_Iso;
            return tprint(
                "{}-{}-{} {}:{}",
                d.year,
                pad2(d.month),
                pad2(d.day),
                pad2(t.hour),
                pad2(t.minute)
            );
        case .Full_Iso;
            sign := ifx offset < 0 "-" else "+";
            off := offset;
            if off < 0 off = -off;
            return tprint(
                "{}-{}-{} {}:{}:{}.{} {}{}{}",
                d.year,
                pad2(d.month),
                pad2(d.day),
                pad2(t.hour),
                pad2(t.minute),
                pad2(t.second),
                pad9(t.nanosecond),
                sign,
                pad2(cast(u8)(off / 3600)),
                pad2(cast(u8)((off / 60) % 60))
            );
        case .Relative;
            return relative_time(current_time() - seconds);
    }
}

/// eza's relative style: "20 hours", "3 weeks", "1 year".
relative_time :: (delta: s64) -> str {
    future := delta < 0;
    span := delta;
    if future span = -delta;
    amount: s64;
    unit: str;
    if span < 60 {
        amount = span;
        unit = "second";
    } else if span < 3600 {
        amount = span / 60;
        unit = "minute";
    } else if span < 86400 {
        amount = span / 3600;
        unit = "hour";
    } else if span < 86400 * 7 {
        amount = span / 86400;
        unit = "day";
    } else if span < 2_630_016 {
        amount = span / (86400 * 7);
        unit = "week";
    } else if span < 31_556_952 {
        amount = span / 2_630_016;
        unit = "month";
    } else {
        amount = span / 31_556_952;
        unit = "year";
    }
    plural := ifx amount == 1 "" else "s";
    if future return tprint("in {} {}{}", amount, unit, plural);
    return tprint("{} {}{}", amount, unit, plural);
}

pad2 :: (v: u8) -> str {
    if v < 10 return tprint("0{}", v);
    return tprint("{}", v);
}

pad2s :: (v: u8) -> str {
    if v < 10 return tprint(" {}", v);
    return tprint("{}", v);
}

pad9 :: (v: u32) -> str {
    text := tprint("{}", v);
    if text.count >= 9 return text;
    b: String_Builder;
    b.allocator = context.temp_allocator;
    b.write_repeated_byte(#char "0", 9 - text.count);
    b.write_string(text);
    return b.to_string();
}

}

// ---------------------------------------------------------------------------
// Sizes and permissions.

#public {

Size_Format :: enum {
    Decimal;
    Binary;
    Bytes;
}

/// Splits a byte count into a number and a unit for display, exactly as
/// eza prints it: 1234 -> ("1.2", "k"), 999 -> ("999", ""),
/// binary 1536 -> ("1.5", "Ki"). Values below 10 keep one decimal.
human_size :: (bytes: s64, fmt: Size_Format) -> (str, str) {
    if fmt == .Bytes || bytes < 0 return tprint("{}", group_digits(bytes)), "";
    base: f64 = ifx fmt == .Binary 1024.0 else 1000.0;
    decimal_units: [_]str = .["k", "M", "G", "T", "P", "E"];
    binary_units: [_]str = .["Ki", "Mi", "Gi", "Ti", "Pi", "Ei"];
    value := cast(f64) bytes;
    if value < base return tprint("{}", group_digits(bytes)), "";
    unit: ssize = -1;
    while value >= base && unit < 5 {
        value /= base;
        unit += 1;
    }
    name := ifx fmt == .Binary binary_units[unit] else decimal_units[unit];
    if value < 10.0 {
        tenths := round_half_even(value, 10);
        return tprint("{}.{}", tenths / 10, tenths % 10), name;
    }
    // eza rounds whole numbers half away from zero.
    return tprint("{}", cast(s64) round(value)), name;
}

/// `value * scale` rounded to an integer the way Rust's float formatting
/// rounds: from the exact binary value, ties to even. Positive inputs.
round_half_even :: (value: f64, scale: s64) -> s64 {
    bits := value.to_bits();
    exponent := cast(s64)((bits >> 52) & 16#7ff);
    mantissa := cast(s128)(bits & 16#f_ffff_ffff_ffff);
    if exponent == 0 exponent = 1;
    else mantissa += cast(s128) 1 << cast(s128) 52;
    // value = mantissa * 2^(exponent - 1075)
    shift := exponent - 1075;
    numerator := mantissa * cast(s128) scale;
    if shift >= 0 return cast(s64)(numerator << cast(s128) shift);
    if shift < -120 return 0;
    denominator := cast(s128) 1 << cast(s128)(-shift);
    quotient := numerator / denominator;
    remainder := numerator % denominator;
    twice := remainder * 2;
    if twice > denominator || (twice == denominator && (quotient & 1) == 1) quotient += 1;
    return cast(s64) quotient;
}

/// Compact size for the TUI: "4.0K", "12M", "512B".
short_size :: (bytes: s64) -> str {
    units: [_]str = .["B", "K", "M", "G", "T", "P", "E"];
    value := cast(f64) bytes;
    unit: ssize = 0;
    while value >= 1024.0 && unit < 6 {
        value /= 1024.0;
        unit += 1;
    }
    if unit == 0 return tprint("{}B", bytes);
    if value < 10.0 {
        tenths := cast(s64)(value * 10.0 + 0.5);
        if tenths < 100 return tprint("{}.{}{}", tenths / 10, tenths % 10, units[unit]);
    }
    return tprint("{}{}", cast(s64)(value + 0.5), units[unit]);
}

/// 1234567 -> "1,234,567" (temporary).
group_digits :: (value: s64) -> str {
    text := tprint("{}", value);
    negative := value < 0;
    digits := ifx negative text[1..text.count] else text;
    if digits.count <= 3 return text;
    b: String_Builder;
    b.allocator = context.temp_allocator;
    if negative b.write_byte(#char "-");
    lead := digits.count % 3;
    if lead > 0 b.write_string(digits[0..lead]);
    i := lead;
    while i < digits.count {
        if i > 0 b.write_byte(#char ",");
        b.write_string(digits[i..i + 3]);
        i += 3;
    }
    return b.to_string();
}

}
